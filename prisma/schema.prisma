// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Service {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  shortDesc String
  longDesc  String
  category  String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Industry {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model Job {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  location       String
  employmentType String
  summary        String
  description    String
  requirements   String
  status         JobStatus @default(DRAFT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id          Int               @id @default(autoincrement())
  jobId       Int?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  fullName    String
  email       String
  phone       String?
  resumeUrl   String
  message     String?
  status      ApplicationStatus @default(NEW)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
}

model ResumeSubmission {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  resumeUrl String
  message   String?
  createdAt DateTime @default(now())
}

model GetHiredSubmission {
  id                Int       @id @default(autoincrement())
  fullName          String
  email             String
  phone             String?
  linkedinUrl       String?
  visaStatus        String
  yearsOfExperience String
  targetRoles       String
  resumeUrl         String
  message           String?
  createdAt         DateTime  @default(now())
  // Triage state for /admin/contacts — team-only, never surfaced publicly.
  handled           Boolean   @default(false)
  handledAt         DateTime?
  notes             String?

  @@index([handled, createdAt])
}

model ContactSubmission {
  id              Int       @id @default(autoincrement())
  fullName        String
  company         String?
  email           String
  phone           String?
  serviceInterest String?
  message         String
  createdAt       DateTime  @default(now())
  // Triage state for /admin/contacts — team-only, never surfaced publicly.
  handled         Boolean   @default(false)
  handledAt       DateTime?
  notes           String?

  @@index([handled, createdAt])
}

// ── Live customer results feed (/results, /for-employees) ──────────────────

model CustomerResult {
  id        String             @id @default(cuid())
  slug      String             @unique // "workday-consultant-aug-2026"
  headline  String // "30 days, 3 employer calls"
  profile   String // "Workday/HCM consultant, 6+ yrs"
  track     ResultTrack        @default(CORE_TECH)
  joinedAt  DateTime // day 0 — drives "day N with Globixs"
  story     String             @db.Text // markdown, 2–3 paragraphs
  consentAt DateTime? // null = never publishable
  published Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  responses EmployerResponse[]

  @@index([published, createdAt])
}

model EmployerResponse {
  id         String         @id @default(cuid())
  resultId   String
  result     CustomerResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  company    String // "Southwest Airlines"
  type       ResponseType
  role       String? // "T&OS Analytics Consultant"
  imagePath  String // path in Supabase bucket "results" — REDACTED file only
  receivedOn DateTime
  createdAt  DateTime       @default(now())

  @@index([receivedOn])
}

enum ResultTrack {
  CORE_TECH
  UNSATURATED
}

enum ResponseType {
  INTERVIEW_INVITE
  RECRUITER_SCREEN
  SCREENING_QUESTION
  OFFER
}
